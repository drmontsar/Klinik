{
  "name": "kl-phase2-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/main.ts",
    "worker:build": "bun run scripts/build-worker.ts",
    "worker:dev": "wrangler dev --local",
    "migrate": "bun run src/db/migrate.ts",
    "seed": "bun run src/db/seed-test-data.ts",
    "seed:care-area": "bun run src/db/seed-care-area.ts",
    "seed:qa": "bun run scripts/seed-qa.ts",
    "qa:coverage": "bun run scripts/qa-coverage.ts",
    "qa:verify": "bun run scripts/verify-qa.ts",
    "auth:bootstrap-admin": "bun run src/db/bootstrap-admin.ts",
    "reset:demo": "bun run src/db/seed-test-data.ts --reset",
    "assign:test-user": "bun run src/db/assign-test-user.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bash scripts/test-integration.sh",
    "verify": "bun run check && bun test && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.162.0"
  }
}
