DATABASE_URL=postgres://klinik:klinik@localhost:5433/klinik
POSTGRES_PORT=5433
PORT=3001
# info hides routine request logs; debug includes them.
LOG_LEVEL=info
# Set to false to bypass per-user app-access restrictions (login and roles still apply).
ACCESS_CONTROL=false
# Local SeaweedFS; change to your private S3-compatible bucket on deployment.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=klinik-chat
S3_ACCESS_KEY_ID=klinik-local
S3_SECRET_ACCESS_KEY=klinik-local-secret
